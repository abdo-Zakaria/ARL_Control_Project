<?xml version="1.0"?>
<!-- A model of the F1TENTH racecar for rviz -->
<robot name="racecar">

  <material name="black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.3 0.57 1.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <link name="ego_racecar/base_link">
    <visual>
      <origin xyz="0.625000 0 0.090000"/>
      <geometry>
        <box size="1.250000 1.141900 0.100000"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="base_to_laser_model" type="fixed">
    <parent link="ego_racecar/base_link"/>
    <child link="ego_racecar/laser_model"/>
    <origin xyz="0.275000 0 0.165000"/>
  </joint>

  <link name="ego_racecar/laser_model">
    <visual>
      <geometry>
        <cylinder radius="0.026000" length="0.050000"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_back_left_wheel" type="continuous">
    <parent link="ego_racecar/base_link"/>
    <child link="ego_racecar/back_left_wheel"/>
    <origin xyz="0 0.590000 0.500000"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="ego_racecar/back_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.500000" length="0.300000"/>
      </geometry>
      <material name="black"/>
      <origin rpy="1.570796 0 0"/>
    </visual>
  </link>

  <joint name="base_to_back_right_wheel" type="continuous">
    <parent link="ego_racecar/base_link"/>
    <child link="ego_racecar/back_right_wheel"/>
    <origin xyz="0 -0.590000 0.500000"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="ego_racecar/back_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.500000" length="0.300000"/>
      </geometry>
      <material name="black"/>
      <origin rpy="1.570796 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_left_hinge" type="revolute">
    <parent link="ego_racecar/base_link"/>
    <child link="ego_racecar/front_left_hinge"/>
    <origin xyz="1.250000 0.590000 0.500000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.610865" upper="0.610865" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="ego_racecar/front_left_hinge"/>

  <joint name="front_left_hinge_to_wheel" type="continuous">
    <parent link="ego_racecar/front_left_hinge"/>
    <child link="ego_racecar/front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="ego_racecar/front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.500000" length="0.300000"/>
      </geometry>
      <material name="black"/>
      <origin rpy="1.570796 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_right_hinge" type="revolute">
    <parent link="ego_racecar/base_link"/>
    <child link="ego_racecar/front_right_hinge"/>
    <origin xyz="1.250000 -0.590000 0.500000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.610865" upper="0.610865" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="ego_racecar/front_right_hinge"/>

  <joint name="front_right_hinge_to_wheel" type="continuous">
    <parent link="ego_racecar/front_right_hinge"/>
    <child link="ego_racecar/front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="ego_racecar/front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.500000" length="0.300000"/>
      </geometry>
      <material name="black"/>
      <origin rpy="1.570796 0 0"/>
    </visual>
  </link>

</robot>
