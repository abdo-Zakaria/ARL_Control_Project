<?xml version="1.0"?>
<!--
  edges_gazebo.xacro - Gazebo Harmonic physics + Ackermann drive for the edges robot.

  <gazebo reference="..."> can only tune a link (friction, ...). It cannot create
  <inertial> or <collision> elements. So each link gets a small "<link>_phys" helper
  child welded by a fixed joint. It carries the mass, inertia and collision geometry.
  sdformat lumps fixed joints, so in Gazebo the helper merges into its parent link.
  one_st_urdf.urdf.xacro is not modified.

  The link/joint names below follow bicycle_sim/urdf/racecar.xacro.
  If one_st_urdf.urdf.xacro uses other names, edit ONLY the property block.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================== EDIT HERE IF NAMES / DIMENSIONS DIFFER ====================== -->
  <xacro:property name="g_car"       value="ego_racecar"/>
  <xacro:property name="g_base"      value="${g_car}/base_link"/>
  <xacro:property name="g_laser"     value="${g_car}/laser_model"/>
  <xacro:property name="g_rl_wheel"  value="${g_car}/back_left_wheel"/>
  <xacro:property name="g_rr_wheel"  value="${g_car}/back_right_wheel"/>
  <xacro:property name="g_fl_hinge"  value="${g_car}/front_left_hinge"/>
  <xacro:property name="g_fr_hinge"  value="${g_car}/front_right_hinge"/>
  <xacro:property name="g_fl_wheel"  value="${g_car}/front_left_wheel"/>
  <xacro:property name="g_fr_wheel"  value="${g_car}/front_right_wheel"/>

  <!-- joint names (used by the Ackermann plugin) -->
  <xacro:property name="j_rl_wheel"  value="base_to_back_left_wheel"/>
  <xacro:property name="j_rr_wheel"  value="base_to_back_right_wheel"/>
  <xacro:property name="j_fl_steer"  value="base_to_front_left_hinge"/>
  <xacro:property name="j_fr_steer"  value="base_to_front_right_hinge"/>

  <!-- geometry (m) - same numbers as racecar.xacro -->
  <xacro:property name="g_wheelbase" value="1.25"/>
  <xacro:property name="g_track"     value="1.18"/>
  <xacro:property name="g_wheel_r"   value="0.5"/>
  <xacro:property name="g_wheel_len" value="0.3"/>
  <xacro:property name="g_body_h"    value="0.1"/>
  <xacro:property name="g_gnd_off"   value="0.04"/>
  <xacro:property name="g_body_w"    value="${g_track - g_wheel_len}"/>

  <!-- mass (kg) and friction: tune these -->
  <xacro:property name="m_chassis"   value="18.0"/>
  <xacro:property name="m_wheel"     value="2.0"/>
  <xacro:property name="m_hinge"     value="0.5"/>
  <xacro:property name="m_laser"     value="0.2"/>
  <xacro:property name="mu_wheel"    value="1.0"/>
  <xacro:property name="mu_chassis"  value="0.2"/>
  <xacro:property name="steer_limit" value="0.610865"/>   <!-- 35 deg, same as the URDF -->
  <xacro:property name="v_max"       value="25.0"/>       <!-- same cap as the kinematic sim -->
  <!-- ==================================================================================== -->

  <!-- Helper link carrying mass + inertia only (no collision) -->
  <xacro:macro name="phys_inertial" params="link mass ixx iyy izz cx:=0 cy:=0 cz:=0">
    <link name="${link}_phys">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
      </inertial>
    </link>
    <joint name="${link}_phys_joint" type="fixed">
      <parent link="${link}"/>
      <child link="${link}_phys"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Helper link carrying mass + inertia + collision (collision passed as a block) -->
  <xacro:macro name="phys_solid" params="link mass ixx iyy izz cx:=0 cy:=0 cz:=0 *collision">
    <link name="${link}_phys">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
      </inertial>
      <xacro:insert_block name="collision"/>
    </link>
    <joint name="${link}_phys_joint" type="fixed">
      <parent link="${link}"/>
      <child link="${link}_phys"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Wheel: solid cylinder, spin axis = link Y (same orientation as the visual) -->
  <xacro:macro name="phys_wheel" params="link">
    <xacro:phys_solid link="${link}" mass="${m_wheel}"
        ixx="${m_wheel/12.0*(3.0*g_wheel_r*g_wheel_r + g_wheel_len*g_wheel_len)}"
        iyy="${0.5*m_wheel*g_wheel_r*g_wheel_r}"
        izz="${m_wheel/12.0*(3.0*g_wheel_r*g_wheel_r + g_wheel_len*g_wheel_len)}">
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${g_wheel_r}" length="${g_wheel_len}"/>
        </geometry>
      </collision>
    </xacro:phys_solid>
  </xacro:macro>

  <!-- Chassis: solid box, same size/pose as the visual -->
  <xacro:phys_solid link="${g_base}" mass="${m_chassis}"
      cx="${g_wheelbase/2}" cy="0" cz="${g_gnd_off + g_body_h/2}"
      ixx="${m_chassis/12.0*(g_body_w*g_body_w + g_body_h*g_body_h)}"
      iyy="${m_chassis/12.0*(g_wheelbase*g_wheelbase + g_body_h*g_body_h)}"
      izz="${m_chassis/12.0*(g_wheelbase*g_wheelbase + g_body_w*g_body_w)}">
    <collision>
      <origin xyz="${g_wheelbase/2} 0 ${g_gnd_off + g_body_h/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${g_wheelbase} ${g_body_w} ${g_body_h}"/>
      </geometry>
    </collision>
  </xacro:phys_solid>

  <xacro:phys_wheel link="${g_rl_wheel}"/>
  <xacro:phys_wheel link="${g_rr_wheel}"/>
  <xacro:phys_wheel link="${g_fl_wheel}"/>
  <xacro:phys_wheel link="${g_fr_wheel}"/>

  <!-- Steering hinges and sensor mount: small mass, no collision -->
  <xacro:phys_inertial link="${g_fl_hinge}" mass="${m_hinge}" ixx="0.001" iyy="0.001" izz="0.001"/>
  <xacro:phys_inertial link="${g_fr_hinge}" mass="${m_hinge}" ixx="0.001" iyy="0.001" izz="0.001"/>
  <xacro:phys_inertial link="${g_laser}" mass="${m_laser}" ixx="0.0001" iyy="0.0001" izz="0.0001"/>

  <!-- ===================== Gazebo friction (link level) ===================== -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>${mu_wheel}</mu1>
      <mu2>${mu_wheel}</mu2>
    </gazebo>
    <gazebo reference="${link}_phys">
      <mu1>${mu_wheel}</mu1>
      <mu2>${mu_wheel}</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="${g_rl_wheel}"/>
  <xacro:wheel_friction link="${g_rr_wheel}"/>
  <xacro:wheel_friction link="${g_fl_wheel}"/>
  <xacro:wheel_friction link="${g_fr_wheel}"/>

  <gazebo reference="${g_base}">
    <mu1>${mu_chassis}</mu1>
    <mu2>${mu_chassis}</mu2>
  </gazebo>
  <gazebo reference="${g_base}_phys">
    <mu1>${mu_chassis}</mu1>
    <mu2>${mu_chassis}</mu2>
  </gazebo>

  <!-- ===================== Gazebo Harmonic system plugins ===================== -->
  <gazebo>
    <!-- Ackermann drive: rear wheels driven, front hinges steered.
         Input  : gz topic /cmd_vel  (Twist: linear.x = speed m/s, angular.z = YAW RATE rad/s)
         Output : gz topic /odom     (odometry starts at 0,0,0 where the car is spawned) -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>${j_rl_wheel}</left_joint>
      <right_joint>${j_rr_wheel}</right_joint>
      <left_steering_joint>${j_fl_steer}</left_steering_joint>
      <right_steering_joint>${j_fr_steer}</right_steering_joint>
      <kingpin_width>${g_track}</kingpin_width>
      <steering_limit>${steer_limit}</steering_limit>
      <wheel_base>${g_wheelbase}</wheel_base>
      <wheel_separation>${g_track}</wheel_separation>
      <wheel_radius>${g_wheel_r}</wheel_radius>
      <min_velocity>0</min_velocity>
      <max_velocity>${v_max}</max_velocity>
      <min_acceleration>-8</min_acceleration>
      <max_acceleration>6</max_acceleration>
      <frame_id>odom</frame_id>
      <child_frame_id>${g_base}</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint states for robot_state_publisher (wheel + steering angles) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>